{
	"name": "@standard-config/tsconfig",
	"version": "3.2.0",
	"description": "Strict config for modern TypeScript runtimes",
	"license": "MIT",
	"author": {
		"name": "Dom Porada",
		"email": "dom@dom.engineering",
		"url": "https://dom.engineering"
	},
	"homepage": "https://sconfig.org/tsconfig",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/standard-config/tsconfig.git"
	},
	"keywords": [
		"nodenext",
		"noemit",
		"standard-config",
		"tsconfig",
		"type-stripping",
		"typescript"
	],
	"files": [
		"tsconfig.bundler.json",
		"tsconfig.json"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		".": "./tsconfig.json",
		"./bundler": "./tsconfig.bundler.json"
	},
	"packageManager": "pnpm@12.14.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24",
			"onFail": "warn"
		}
	},
	"peerDependencies": {
		"typescript": ">=7.1.0-0"
	},
	"peerDependenciesMeta": {
		"typescript": {
			"optional": true
		}
	},
	"devDependencies": {
		"@standard-config/prettier": "^1.22.0",
		"prettier": "^3.9.10",
		"simple-git-hooks": "^2.14.0",
		"typescript": "7.1.0-dev.20261021.1"
	},
	"scripts": {
		"fix": "pnpm format",
		"format": "prettier --ignore-unknown --log-level=warn --write .",
		"format:check": "prettier --check --ignore-unknown .",
		"prepack": "pnpm run '/^(format:check|test)$/'",
		"prepare": "simple-git-hooks",
		"test": "pnpm run '/^test:/'",
		"test:base": "tsc --project tests/tsconfig.json",
		"test:bundler": "tsc --project tests/tsconfig.bundler.json"
	},
	"simple-git-hooks": {
		"pre-commit": "pnpm prepack"
	}
}
